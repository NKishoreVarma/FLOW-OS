{
  "name": "flow-os-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "echo \"[INFO] Workers are embedded inside the main server process. Running the server starts the workers. Run 'npm run start' or 'npm run dev' to start.\"",
    "verify": "node scripts/verify.js",
    "validate": "node scripts/validationSuite.js",
    "trace": "node scripts/trace.js",
    "metrics": "node scripts/metrics.js",
    "brain": "node scripts/brain.js",
    "replay": "node scripts/replay.js",
    "test": "node --test --test-force-exit 'tests/unit/**/*.test.js'",
    "test:unit": "node --test --test-force-exit 'tests/unit/**/*.test.js'",
    "test:integration": "node --test --test-force-exit 'tests/integration/**/*.test.js'",
    "test:validation": "node --test --test-force-exit 'tests/validation/**/*.test.js'",
    "test:all": "node --test --test-force-exit 'tests/**/*.test.js'",
    "test:conversation": "node src/testing/conversation/run-qa.js",
    "test:security": "node src/testing/conversation/run-qa.js --security",
    "test:smoke": "node src/testing/conversation/run-qa.js --smoke",
    "test:qa-stats": "node src/testing/conversation/run-qa.js --stats",
    "demo:reset": "node scripts/seedDemoCompany.js workspace_demo",
    "demo:check": "node scripts/demo-dryrun.js workspace_demo",
    "demo:stress": "node scripts/brain-stress-test.js workspace_demo",
    "demo:runbook": "cat docs/DEMO_RUNBOOK.md",
    "dataset:manifest": "node scripts/certification/dataset.js manifest",
    "dataset:import": "node scripts/certification/dataset.js import",
    "dataset:verify": "node scripts/certification/dataset.js verify",
    "dataset:reset": "node scripts/certification/dataset.js reset",
    "certification": "node scripts/certification/runner.js",
    "certification:full": "node scripts/certification/certify.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@composio/core": "^0.4.0",
    "@google/genai": "^2.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
