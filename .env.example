PORT=5001
NODE_ENV=development

# Core LLM Engines
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://backend.composio.dev/api/v3

# Database & Cache Grid
DATABASE_URL=postgresql://user:password@localhost:5432/flow_os_production
REDIS_URL=redis://127.0.0.1:6379

# Integrations
COMPOSIO_API_KEY=your_composio_api_key_here
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:5001/api/integrations/gmail/callback

# Slack (Communication capability + team notifications)
# Create a Slack app at https://api.slack.com/apps → OAuth & Permissions.
# Bot scopes needed: channels:history, channels:read, chat:write, files:read, users:read
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5001/api/integrations-hub/slack/callback
# Optional: default channel FLOW posts notifications to (id like C0123 or #name).
# If unset, FLOW uses #general (or the first public channel).
SLACK_NOTIFY_CHANNEL=
