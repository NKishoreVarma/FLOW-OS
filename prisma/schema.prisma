generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-Tenant Core ───────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free | starter | pro | enterprise
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspaces Workspace[]
  users      User[]
  apiKeys    ApiKey[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model Workspace {
  id     String @id @default(cuid())
  name   String
  orgId  String @map("org_id")
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Legacy compat: maps to our existing workspace_id header values
  externalId String @unique @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  integrations Integration[]
  agents       Agent[]

  @@map("workspaces")
}

// ─── Identity & Access ───────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(MEMBER)
  orgId        String   @map("org_id")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("users")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  scopes    String[] @default(["read"])
  expiresAt DateTime? @map("expires_at")
  lastUsed  DateTime? @map("last_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}

// ─── Integration Hub ─────────────────────────────────────────────────────────

model Integration {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform     String   // gmail | slack | hubspot | salesforce | etc.
  credentials  Json     @default("{}") // Encrypted OAuth tokens
  syncStatus   String   @default("active") @map("sync_status")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, platform])
  @@map("integrations")
}

// ─── AI Agent Engine ─────────────────────────────────────────────────────────

model Agent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  type        AgentType @default(CHAT)
  provider    String    @default("gemini") // openai | anthropic | gemini
  systemPrompt String?  @map("system_prompt") @db.Text
  config      Json      @default("{}")
  isActive    Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("agents")
}

enum AgentType {
  VOICE
  CHAT
  SALES
  SDR
  SUPPORT
  INTERNAL
}

// ─── Audit Trail ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String   // e.g. "user.login", "agent.created", "integration.connected"
  resource  String?  // e.g. "agent:cuid123"
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
